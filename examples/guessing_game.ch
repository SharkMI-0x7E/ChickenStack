# 猜数字游戏
# 目标数字是 42

# 打印欢迎信息
87 " 101 " 108 " 108 " 111 " 99 " 111 " 109 " 101 " 32 " 116 " 111 " 32 " 116 " 104 " 101 " 32 " 71 " 117 " 101 " 115 " 115 " 105 " 110 " 103 " 32 " 71 " 97 " 109 " 101 " 33 " 10 "
10 "

# 游戏循环 (1 表示继续)
1
[
  # 打印提示
  71 " 117 " 101 " 115 " 115 " 32 " 97 " 32 " 110 " 117 " 109 " 98 " 101 " 114 " 32 " 98 " 101 " 116 " 119 " 101 " 101 " 110 " 32 " 49 " 32 " 97 " 110 " 100 " 32 " 49 " 48 " 48 " 58 " 32 "

  # 输入猜测
  ,

  # 计算差: 42 - guess (栈: [flag, guess] -> [flag, 42, guess] -> [flag, diff])
  42 \
  -

  # 复制差用于条件分支 (栈: [flag, diff, diff])
  :

  # ====== 猜对了? (diff == 0) ======
  0 =
  [
    # 打印恭喜消息
    67 " 111 " 110 " 103 " 114 " 97 " 116 " 117 " 108 " 97 " 116 " 105 " 111 " 110 " 115 " 33 " 32 " 89 " 111 " 117 " 32 " 103 " 117 " 101 " 115 " 115 " 101 " 100 " 32 " 105 " 116 " 33 " 10 "
    $               # 丢弃条件值(1) -> [flag, diff]
    $               # 丢弃 diff 副本 -> [flag]
    0               # 推入 0 (新循环标志) -> [flag, 0]
    \               # 交换 -> [0, flag]
    $               # 丢弃旧标志 -> [0]
    0               # 哨兵0: 使内层[退出 + 供外层清理 -> [0, 0]
  ]

  # 统一清理: 弹出一个值
  # 猜对时:   [0, 0] -> [0] (新标志, 外层循环将退出)
  # 没猜对时: [flag, diff, 0] -> [flag, diff] (0是 0= 的假结果)
  $

  # ====== 太小? (diff > 0, 即 guess < 42) ======
  :
  0 >
  [
    84 " 111 " 111 " 32 " 108 " 111 " 119 " 33 " 32 " 84 " 114 " 121 " 32 " 97 " 103 " 97 " 105 " 110 " 46 " 10 "
    10 "
    $               # 丢弃条件值 -> [flag, diff]
    0               # 哨兵0: 使内层[退出 + 供外层清理 -> [flag, diff, 0]
  ]
  # 统一清理
  # 太小时:   [flag, diff, 0] -> [flag, diff]
  # 不太小时: [flag, diff, 0] -> [flag, diff] (0是 0> 的假结果)
  $

  # ====== 太大? (diff < 0, 即 guess > 42) ======
  # 用 0 \ > 实现 < 判断: (0 > diff) 等价于 (diff < 0)
  :
  0 \
  >
  [
    84 " 111 " 111 " 32 " 104 " 105 " 103 " 104 " 33 " 32 " 84 " 114 " 121 " 32 " 97 " 103 " 97 " 105 " 110 " 46 " 10 "
    10 "
    $               # 丢弃条件值 -> [flag, diff]
    0               # 哨兵0: 使内层[退出 + 供外层清理 -> [flag, diff, 0]
  ]
  # 统一清理
  $

  # 清理剩余的 diff, 保持栈顶为循环标志
  $
  # 栈: [flag] 或 [0], 外层循环据此决定继续或退出
]
